# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Empty values are fine: the matching feature simply stays switched off.

# ── Site ──────────────────────────────────────────────────────────────
# Public address of the site, without a trailing slash. Used for canonical
# URLs, hreflang, sitemap and Open Graph. On Vercel, if this is empty, the
# production domain Vercel provides is used.
NEXT_PUBLIC_SITE_URL=

# ── Contacts (shown on the site) ──────────────────────────────────────
# WhatsApp number in international format, digits only, e.g. 995XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone exactly as it should be displayed, e.g. +995 XXX XX XX XX
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/instatour_china
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ── Analytics (leave empty until you have real IDs) ───────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Where enquiry forms are delivered (server-side, kept secret) ──────
# Any combination works; each configured channel receives every enquiry.
# 1) Telegram bot: create a bot with @BotFather, add it to a chat, get the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 2) Email via Resend (https://resend.com): API key + verified sender
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# 3) Any webhook (Make, Zapier, n8n, Google Apps Script → Google Sheets…)
LEAD_WEBHOOK_URL=
